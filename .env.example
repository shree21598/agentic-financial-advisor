# --- Vertex AI ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Models
ADVISOR_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-005

# Set to 1 to run fully offline (deterministic stub LLM + hashing embeddings).
# Useful for CI / smoke tests. Offline numbers are NOT real model metrics.
ADVISOR_OFFLINE=0

# Staging bucket for Agent Engine deployment
STAGING_BUCKET=gs://your-bucket
